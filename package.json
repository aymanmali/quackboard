{
  "name": "quackboard",
  "version": "0.2.0",
  "description": "AI-powered, source-available Tableau-like Business Intelligence platform built with DuckDB-Wasm, Apache ECharts, Vercel AI SDK, and Next.js",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-duckdb-assets.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-duckdb-assets.mjs",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/openai": "^4.0.122",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@tanstack/react-table": "^8.21.2",
    "ai": "^7.0.179",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.43.1",
    "echarts": "^5.6.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.511.0",
    "mysql2": "^3.14.1",
    "next": "^15.3.2",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^1.5.1",
    "tailwind-merge": "^3.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-grid-layout": "^1.3.5",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
