# Optional: PostgreSQL URL for persistent server-side metadata & saved dashboards.
# If omitted, QuackBoard runs in zero-config local mode using browser IndexedDB.
# DATABASE_URL=postgresql://quackboard:quackboard@localhost:5432/quackboard

# Required when saving encrypted live database credentials (32-byte hex string).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUACKBOARD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional query safety defaults for live SQL connections
QUACKBOARD_QUERY_TIMEOUT_MS=15000
QUACKBOARD_MAX_ROWS=10000
